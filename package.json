{
  "name": "crickey-lite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Live cricket scoring with broadcast overlays for vMix and OBS",
  "author": {
    "name": "Novitas WebWorks",
    "url": "https://novitasweb.works"
  },
  "homepage": "https://novitasweb.works",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite --config web/vite.config.ts\"",
    "build": "vite build --config web/vite.config.ts && tsc --noEmit -p tsconfig.json",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "seed": "tsx server/seed.ts",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
